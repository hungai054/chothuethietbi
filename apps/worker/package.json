    "@rentpro/db": "workspace:*",
    "@rentpro/notifications": "workspace:*",
    "@rentpro/tenancy": "workspace:*",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0"
  }
}
