{
  "name": "@rentpro/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=../../.env --env-file=../web/.env.local --env-file=../admin/.env.local src/main.ts",
