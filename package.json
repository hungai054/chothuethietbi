{
  "name": "rentpro",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint packages apps extensions --no-error-on-unmatched-pattern",
    "test": "turbo run test",
    "e2e": "pnpm --filter @rentpro/web build && pnpm --filter @rentpro/admin build && pnpm --filter @rentpro/e2e e2e",
    "db:reset": "pnpm --filter @rentpro/db reset",
    "dev:web": "pnpm --filter @rentpro/web dev",
    "dev:admin": "pnpm --filter @rentpro/admin dev",
    "db:migrate": "pnpm --filter @rentpro/db migrate",
    "admin:reset-totp": "pnpm --filter @rentpro/db reset-totp",
    "ext:new": "node scripts/ext-new.mjs",
    "ext:sync": "node scripts/ext-sync.mjs",
    "ext:check": "pnpm --filter @rentpro/worker ext:check",
    "ext:migrate": "pnpm --filter @rentpro/worker ext:migrate"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^9.20.0",
    "turbo": "^2.5.0",
    "@rentpro/config": "workspace:*",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
