{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {},
    "test": {
      "dependsOn": [
        "^build"
      ]
    }
  },
  "globalPassThroughEnv": [
    "TEST_PG_SERVER_URL",
    "TEST_DATABASE_ADMIN_URL",
    "TEST_DATABASE_URL",
    "TEST_DATABASE_PLATFORM_URL"
  ]
}